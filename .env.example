HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# Enterprise Compose reads these values; keep .env out of source control.
BUTLER_MODE=enterprise
# local: username/password; oidc: external identity provider (optional).
BUTLER_AUTH_MODE=local
# First startup only; unique 15-128 character password, no default password.
# Remove both bootstrap values after the administrator is created.
BUTLER_ADMIN_USERNAME=
BUTLER_ADMIN_PASSWORD=
BUTLER_DOMAIN=
BUTLER_PUBLIC_URL=
# Optional when running Next.js outside Compose; separate demo service only.
BUTLER_DEMO_API=
BUTLER_DB_PASSWORD=
BUTLER_INTERNAL_TOKEN=
BUTLER_SESSION_SECRET=
BUTLER_OIDC_ISSUER=
BUTLER_OIDC_CLIENT_ID=
BUTLER_OIDC_CLIENT_SECRET=
BUTLER_OIDC_CLIENT_AUTH_METHOD=client_secret_basic
BUTLER_BOOTSTRAP_ADMIN_SUB=
# Direct API startup requires a PostgreSQL URL. Compose constructs its own URL.
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
ATLASSIAN_API_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=
COS_BUCKET=
